# Supabase Cloud or Local Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CITY=Hyderabad
NEXT_PUBLIC_DEFAULT_LAT=17.3850
NEXT_PUBLIC_DEFAULT_LNG=78.4867

# Emergency Numbers
NEXT_PUBLIC_EMERGENCY_NATIONAL=112
NEXT_PUBLIC_EMERGENCY_NDRF=011-24363260
NEXT_PUBLIC_EMERGENCY_STATE_DISASTER=1070

# Feature Flags
NEXT_PUBLIC_ENABLE_SIMULATION_MODE=true
